theory BluetoothPairing_ContextBound

begin

/*
 * Context-bound BLE SMP Secure Connections abstraction.
 *
 * Scope:
 *   - BLE SMP Phase-1 feature exchange
 *   - Pairing Request / Pairing Response
 *   - Abstract Passkey Entry confirmation
 *   - Confirmation explicitly bound to the local transcript
 *   - Dolev--Yao control over the public network
 *
 * Main difference from BluetoothPairing_Standard.spthy:
 *
 *   Standard:
 *       confirm(auth)
 *
 *   Context-bound:
 *       confirm_ctx(auth, PairingRequest, PairingResponse)
 *
 * The context-bound confirmation prevents a modified or replayed
 * negotiation transcript from being accepted by both endpoints under the
 * same abstract session.
 *
 * This is a symbolic abstraction. It does not model:
 *   - concrete BLE link-layer channel hopping;
 *   - concrete elliptic-curve arithmetic;
 *   - the complete Bluetooth f4/f5/f6/g2 definitions;
 *   - concrete AES-CMAC computation;
 *   - physical radio timing;
 *   - a concrete BLE KeySize=7 implementation;
 *   - human probability or UI timing.
 */


/*
 * The symmetric-encryption builtin is used only by the abstract
 * low-entropy recovery rule near the end of this file.
 */
builtins:
  symmetric-encryption


/*
 * confirm_ctx/3:
 *
 *   Abstract context-bound confirmation value.
 *
 * session_key/3:
 *
 *   Abstract final key term derived from the locally observed request,
 *   response, and authentication material.
 *
 * The model does not claim that these constructors are concrete Bluetooth
 * primitives. They represent the required dependency structure.
 */
functions:
  confirm_ctx/3,
  session_key/3


/*
 * --------------------------------------------------------------------------
 * Facts
 * --------------------------------------------------------------------------
 *
 * I_Wait:
 *   Initiator has sent a Pairing Request and waits for a response.
 *
 * R_Wait:
 *   Responder has accepted a locally observed Pairing Request and sent a
 *   Pairing Response.
 *
 * I_Done / R_Done:
 *   Local terminal markers.
 *
 * LowEntropyKey:
 *   Abstract classification of a key as belonging to a reduced effective
 *   key space.
 */


/*
 * --------------------------------------------------------------------------
 * Initiator: Phase 1
 * --------------------------------------------------------------------------
 *
 * The Pairing Request is represented structurally rather than as the
 * concrete seven-octet SMP payload.
 *
 * The request contains:
 *
 *   - role marker;
 *   - session identifier;
 *   - IOCap;
 *   - AuthReq;
 *   - KeySize;
 *   - abstract authentication material.
 *
 * The request is sent over the public network and can therefore be replaced
 * by the adversary.
 */
rule Initiator_Start:
  [ Fr(~sid), Fr(~auth) ]
  --[
      PairingRequestSent(
        'I',
        'R',
        ~sid,
        <
          'DisplayYesNo',
          'MITM',
          '16'
        >,
        ~auth
      )
    ]->
  [
      Out(
        <
          'PairingRequest',
          ~sid,
          <
            'DisplayYesNo',
            'MITM',
            '16'
          >,
          ~auth
        >
      ),

      I_Wait(
        ~sid,
        ~auth,
        <
          'DisplayYesNo',
          'MITM',
          '16'
        >
      )
  ]


/*
 * --------------------------------------------------------------------------
 * Responder: Phase 1
 * --------------------------------------------------------------------------
 *
 * The responder accepts the request actually observed on the network.
 *
 * Req_R is therefore the responder's local request view. It may differ from
 * the request originally generated by the initiator because the public
 * network is adversary-controlled.
 */
rule Responder_Accept_Request:
  [ In(<
        'PairingRequest',
        sid,
        Req_R,
        auth
      >),
    Fr(~rsp_R) ]
  --[
      PairingRequestReceived(
        'R',
        'I',
        sid,
        Req_R,
        auth
      ),

      PairingResponseSent(
        'R',
        'I',
        sid,
        Req_R,
        ~rsp_R,
        auth
      )
    ]->
  [
      Out(
        <
          'PairingResponse',
          sid,
          Req_R,
          ~rsp_R,
          auth
        >
      ),

      R_Wait(
        sid,
        Req_R,
        ~rsp_R,
        auth
      )
  ]


/*
 * --------------------------------------------------------------------------
 * Initiator: context-bound confirmation
 * --------------------------------------------------------------------------
 *
 * The initiator uses its own local request view Req_I and the received
 * response Rsp_I as the confirmation context:
 *
 *   confirm_ctx(auth, Req_I, Rsp_I)
 *
 * The response includes an echoed request field. The initiator requires the
 * echo to equal its own original request. This models the intended
 * transcript-consistency check at the receiving endpoint.
 *
 * If an attacker changes the request before it reaches the responder, then
 * the responder's local Req_R differs from Req_I. In that case, the
 * responder's expected confirmation will not equal the value generated here.
 */
rule Initiator_Confirm_ContextBound:
  [ I_Wait(
      sid,
      auth,
      Req_I
    ),
    In(<
      'PairingResponse',
      sid,
      Req_I,
      Rsp_I,
      auth
    >) ]
  --[
      ConfirmationGenerated(
        'I',
        'R',
        sid,
        confirm_ctx(
          auth,
          Req_I,
          Rsp_I
        )
      ),

      Commit_Init(
        'I',
        'R',
        sid,
        session_key(
          Req_I,
          Rsp_I,
          auth
        ),
        Req_I,
        Rsp_I
      )
    ]->
  [
      Out(
        <
          'Confirmation',
          sid,
          confirm_ctx(
            auth,
            Req_I,
            Rsp_I
          )
        >
      ),

      I_Done(
        sid,
        auth,
        Req_I,
        Rsp_I
      )
  ]


/*
 * --------------------------------------------------------------------------
 * Responder: context-bound confirmation verification
 * --------------------------------------------------------------------------
 *
 * The responder expects:
 *
 *   confirm_ctx(auth, Req_R, Rsp_R)
 *
 * where Req_R and Rsp_R are exactly the responder's local transcript.
 *
 * A confirmation generated with a different transcript cannot unify with
 * this expected term in the free term algebra.
 */
rule Responder_Verify_ContextBound:
  [ R_Wait(
      sid,
      Req_R,
      Rsp_R,
      auth
    ),
    In(<
      'Confirmation',
      sid,
      confirm_ctx(
        auth,
        Req_R,
        Rsp_R
      )
    >) ]
  --[
      ConfirmationVerified(
        'R',
        'I',
        sid,
        confirm_ctx(
          auth,
          Req_R,
          Rsp_R
        )
      ),

      Commit_Res(
        'R',
        'I',
        sid,
        session_key(
          Req_R,
          Rsp_R,
          auth
        ),
        Req_R,
        Rsp_R
      )
    ]->
  [
      R_Done(
        sid,
        auth,
        Req_R,
        Rsp_R
      )
  ]


/*
 * --------------------------------------------------------------------------
 * Optional transcript records
 * --------------------------------------------------------------------------
 *
 * These rules expose each endpoint's locally accepted transcript in the
 * trace. They are useful for manual inspection and for adding stronger
 * correspondence properties later.
 */
rule Record_Initiator_Transcript:
  [ I_Done(
      sid,
      auth,
      Req_I,
      Rsp_I
    ) ]
  --[
      InitTranscript(
        sid,
        Req_I,
        Rsp_I
      )
    ]->
  [ ]


rule Record_Responder_Transcript:
  [ R_Done(
      sid,
      auth,
      Req_R,
      Rsp_R
    ) ]
  --[
      ResTranscript(
        sid,
        Req_R,
        Rsp_R
      )
    ]->
  [ ]


/*
 * --------------------------------------------------------------------------
 * User-interface abstraction
 * --------------------------------------------------------------------------
 *
 * This rule is kept parallel to the standard model. It represents the
 * nondeterministic prompt-confusion abstraction:
 *
 *   - one endpoint displays a value;
 *   - another endpoint requests input;
 *   - the user transfers the displayed value to the input prompt.
 *
 * It does not claim that a concrete operating system has exactly this UI.
 */
rule User_Prompt_Confusion_Abstraction:
  [ In(<
      'DisplayYesNo',
      D1,
      U,
      Passkey
    >),
    In(<
      'AskInput',
      D2,
      U,
      'Input'
    >) ]
  --[
      UserPromptConfusion(
        U,
        D1,
        D2,
        Passkey
      )
    ]->
  [
      Out(<
        'Confirm',
        U,
        D1,
        'Y'
      >),

      Out(<
        'Input',
        U,
        D2,
        Passkey
      >)
  ]


/*
 * --------------------------------------------------------------------------
 * Abstract low-entropy policy
 * --------------------------------------------------------------------------
 *
 * This rule intentionally does not model a concrete BLE key-size downgrade.
 * It only records the abstract event that a key is accepted as belonging to
 * a reduced effective key space.
 */
rule Accept_Abstract_Low_Entropy_Policy:
  [ In(<
      'LowEntropyPolicy',
      sid,
      K
    >) ]
  --[
      LowEntropyAccepted(
        sid,
        K
      )
    ]->
  [
      !LowEntropyKey(K)
  ]


/*
 * --------------------------------------------------------------------------
 * Abstract low-entropy recovery
 * --------------------------------------------------------------------------
 *
 * This is an over-approximation of exhaustive search. It is not a literal
 * enumeration of candidates and must not be interpreted as a concrete
 * cracking-time estimate.
 */
rule Abstract_Low_Entropy_Recovery:
  [ !LowEntropyKey(K),
    In(senc(M, K)) ]
  --[
      ExhaustiveSearchAbstraction(K)
    ]->
  [
      Out(K)
  ]


/*
 * --------------------------------------------------------------------------
 * Security properties
 * --------------------------------------------------------------------------
 *
 * Main agreement property:
 *
 * If the initiator and responder both commit for the same abstract session,
 * their final key terms must be equal.
 *
 * Because the responder accepts only:
 *
 *   confirm_ctx(auth, Req_R, Rsp_R)
 *
 * and the initiator sends:
 *
 *   confirm_ctx(auth, Req_I, Rsp_I)
 *
 * both confirmation terms can match only when the corresponding transcript
 * terms match in the free term algebra.
 */
lemma Agreement_Negotiation:
  "All I R sid KI KR ReqI RspI ReqR RspR #i #j.
      Commit_Init(
        I,
        R,
        sid,
        KI,
        ReqI,
        RspI
      ) @ i
    & Commit_Res(
        R,
        I,
        sid,
        KR,
        ReqR,
        RspR
      ) @ j
    ==>
      KI = KR"


/*
 * Stronger transcript agreement property.
 *
 * A successful proof establishes that two commits for one abstract session
 * cannot use different local request or response terms.
 */
lemma Agreement_Transcript:
  "All I R sid KI KR ReqI RspI ReqR RspR #i #j.
      Commit_Init(
        I,
        R,
        sid,
        KI,
        ReqI,
        RspI
      ) @ i
    & Commit_Res(
        R,
        I,
        sid,
        KR,
        ReqR,
        RspR
      ) @ j
    ==>
        (
          ReqI = ReqR
        & RspI = RspR
        & KI = KR
        )"


/*
 * Explicit absence of the standard-model divergence witness.
 *
 * If both parties commit, the context-bound model does not permit a trace
 * in which either transcript component differs.
 */
lemma No_Reachable_Transcript_Divergence:
  "All I R sid KI KR ReqI RspI ReqR RspR #i #j.
      Commit_Init(
        I,
        R,
        sid,
        KI,
        ReqI,
        RspI
      ) @ i
    & Commit_Res(
        R,
        I,
        sid,
        KR,
        ReqR,
        RspR
      ) @ j
    ==>
        (
          ReqI = ReqR
        & RspI = RspR
        )"


/*
 * The low-entropy abstraction remains separately reachable. Transcript
 * binding does not by itself prove a concrete entropy lower bound.
 */
lemma Reachable_Low_Entropy_Recovery:
  exists-trace
  "Ex K #i.
      ExhaustiveSearchAbstraction(K) @ i"


end
